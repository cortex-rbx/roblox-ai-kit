<roblox version="4">
  <Item class="Script" referent="RBX0">
    <Properties>
      <string name="Name">CortexStudio</string>
      <token name="RunContext">0</token>
      <ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	Cortex Studio — AI coding terminal (Roblox Studio plugin)
	UI ported to match the HTML mockup parameters (colors, spacing, radii, motion).

	INSTALL: Studio → Plugins tab → "Plugins Folder" → drop the .rbxmx there → restart Studio.
	(Or paste this into a Script → right-click → "Save as Local Plugin".)

	USE: /key YOUR_KEY  ·  select a script  ·  type a request  ·  /apply writes the code.
	Commands: /key <k> · /new · /apply .  Works offline with a mock reply.
]]

local HttpService  = game:GetService("HttpService")
local Selection    = game:GetService("Selection")
local TweenService = game:GetService("TweenService")

local BASE = "https://osa-api.netlify.app/npc"

-- ---------- tokens (exact hex from the mockup) ------------------------------
local C = {
	bg    = Color3.fromHex("0c0b0a"), rail  = Color3.fromHex("0a0908"),
	panel = Color3.fromHex("0f0e0d"), panel2= Color3.fromHex("171310"),
	line  = Color3.fromHex("2e2820"), lineS = Color3.fromHex("241e18"),
	text  = Color3.fromHex("f4f0ea"), muted = Color3.fromHex("b0a597"),
	muted2= Color3.fromHex("8b8072"), accent= Color3.fromHex("f5883d"),
	add   = Color3.fromHex("a0c194"), del   = Color3.fromHex("cf8d81"),
}
local SANS   = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
local SANS_B = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
local MONO   = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.SemiBold)

-- {display name, unit cost, gateway frontier tier}
local MODELS = {
	{"Claude Sonnet 5",4,"claude-sonnet-5"},
	{"Claude Opus 4.8",10,"claude-opus-4-8"},
	{"GPT-5",6,"gpt-5"},
	{"Qwen3-Coder 480B",1,"qwen3-coder"},
}
local modelIndex = 1

-- ---------- helpers ----------------------------------------------------------
local function new(cls, props, parent)
	local o = Instance.new(cls)
	for k,v in pairs(props or {}) do o[k]=v end
	if parent then o.Parent=parent end
	return o
end
local function corner(o,r) new("UICorner",{CornerRadius=UDim.new(0,r)},o) end
local function strokeIt(o,col,t) new("UIStroke",{Color=col or C.line,Thickness=t or 1},o) end
local function padAll(o,t,b,l,r) new("UIPadding",{PaddingTop=UDim.new(0,t),PaddingBottom=UDim.new(0,b or t),PaddingLeft=UDim.new(0,l or t),PaddingRight=UDim.new(0,r or l or t)},o) end
local function lbl(props, parent)
	local d = {BackgroundTransparency=1, FontFace=SANS, TextSize=13, TextColor3=C.text,
		TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center}
	for k,v in pairs(props) do d[k]=v end
	return new("TextLabel", d, parent)
end
local function hline(parent, col, y)
	return new("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0, y and 0 or 1, y and 0 or -1),
		BackgroundColor3=col or C.lineS, BorderSizePixel=0}, parent)
end

-- ---------- toolbar + dock ---------------------------------------------------
local toolbar = plugin:CreateToolbar("Cortex")
local button  = toolbar:CreateButton("Cortex","Open the Cortex AI terminal","")
local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right,false,false,460,660,340,440)
local widget = plugin:CreateDockWidgetPluginGui("CortexTerminal_v1", info)
widget.Title = "Cortex"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
button.Click:Connect(function() widget.Enabled = not widget.Enabled end)

-- root fills the widget (kills Studio theme bleed-through)
local root = new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=C.panel,BorderSizePixel=0,
	BackgroundTransparency=1}, widget)

-- ===================== LEFT RAIL ============================================
local rail = new("Frame",{Size=UDim2.new(0,192,1,0),BackgroundColor3=C.rail,BorderSizePixel=0}, root)
new("Frame",{Size=UDim2.new(0,1,1,0),Position=UDim2.new(1,-1,0,0),BackgroundColor3=C.lineS,BorderSizePixel=0}, rail)

-- brand
local brand = new("Frame",{Size=UDim2.new(1,0,0,50),BackgroundTransparency=1}, rail)
padAll(brand,17,14,18,18)
lbl({Size=UDim2.fromScale(1,1),Text='<font color="#f5883d">◆</font>  Cortex',RichText=true,FontFace=SANS_B,TextSize=15,TextColor3=C.text}, brand)
lbl({Size=UDim2.new(0,40,1,0),Position=UDim2.new(1,-46,0,0),Text="beta",TextSize=10,TextColor3=C.muted2,
	TextXAlignment=Enum.TextXAlignment.Right}, brand)

-- new session
local newBtn = new("TextButton",{Size=UDim2.new(1,-24,0,34),Position=UDim2.new(0,12,0,50),
	BackgroundColor3=C.rail,BorderSizePixel=0,AutoButtonColor=false,Text="",}, rail)
corner(newBtn,9); strokeIt(newBtn,C.line)
lbl({Size=UDim2.fromScale(1,1),Position=UDim2.new(0,11,0,0),Text='<font color="#f5883d">+</font>   New session',RichText=true,TextSize=13,TextColor3=C.text}, newBtn)

lbl({Size=UDim2.new(1,0,0,20),Position=UDim2.new(0,18,0,90),Text="SESSIONS",TextSize=10,TextColor3=C.muted2}, rail)

-- session list
local sessWrap = new("ScrollingFrame",{Size=UDim2.new(1,-8,1,-90-20-96),Position=UDim2.new(0,4,0,110),
	BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=C.line,
	CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y}, rail)
padAll(sessWrap,0,0,4,4)
new("UIListLayout",{Padding=UDim.new(0,2),SortOrder=Enum.SortOrder.LayoutOrder}, sessWrap)
local SESS = {"Shopkeeper greets by name","Fix leaderboard DataStore","Enemy AI patrol paths",
	"Quest generator NPC","Sword combat hit detection","Round timer + intermission","Shop GUI + purchase flow"}
local sesItems = {}
local function setActiveSes(idx)
	for i,it in ipairs(sesItems) do
		local on = (i==idx)
		it.btn.BackgroundTransparency = on and 0 or 1
		it.dot.BackgroundColor3 = on and C.accent or C.muted2
		it.txt.TextColor3 = on and C.text or C.muted
	end
end
local function makeSes(text, i)
	local b = new("TextButton",{Size=UDim2.new(1,0,0,30),BackgroundColor3=C.panel2,BorderSizePixel=0,
		AutoButtonColor=false,Text="",LayoutOrder=i,BackgroundTransparency=(i==1) and 0 or 1}, sessWrap)
	corner(b,8)
	local dot = new("Frame",{Size=UDim2.new(0,4,0,4),Position=UDim2.new(0,11,0.5,-2),
		BackgroundColor3=(i==1) and C.accent or C.muted2,BorderSizePixel=0}, b)
	corner(dot,2)
	local t = lbl({Size=UDim2.new(1,-28,1,0),Position=UDim2.new(0,22,0,0),Text=text,TextSize=13,
		TextColor3=(i==1) and C.text or C.muted,TextTruncate=Enum.TextTruncate.AtEnd}, b)
	sesItems[i] = {btn=b, dot=dot, txt=t}
	b.MouseButton1Click:Connect(function() setActiveSes(i) end)
end
for i,s in ipairs(SESS) do makeSes(s,i) end

-- rail foot
local foot = new("Frame",{Size=UDim2.new(1,0,0,96),Position=UDim2.new(0,0,1,-96),BackgroundTransparency=1}, rail)
hline(foot,C.lineS,true)
padAll(foot,14,14,16,16)
lbl({Size=UDim2.new(1,0,0,16),Text="Beta plan",TextSize=12,TextColor3=C.muted}, foot)
lbl({Size=UDim2.new(1,0,0,16),Text="1,240 u",TextSize=12,TextColor3=C.text,TextXAlignment=Enum.TextXAlignment.Right}, foot)
local barBg = new("Frame",{Size=UDim2.new(1,0,0,3),Position=UDim2.new(0,0,0,24),BackgroundColor3=Color3.fromHex("1a1613"),BorderSizePixel=0}, foot)
corner(barBg,2)
local barFill = new("Frame",{Size=UDim2.new(0.62,0,1,0),BackgroundColor3=C.accent,BackgroundTransparency=0.35,BorderSizePixel=0}, barBg)
corner(barFill,2)
local upg = new("TextButton",{Size=UDim2.new(1,0,0,30),Position=UDim2.new(0,0,0,40),BackgroundColor3=C.rail,
	BorderSizePixel=0,AutoButtonColor=false,Text="Upgrade",FontFace=SANS,TextSize=12,TextColor3=C.muted}, foot)
corner(upg,8); strokeIt(upg,C.line)

-- ===================== MAIN =================================================
local main = new("Frame",{Size=UDim2.new(1,-192,1,0),Position=UDim2.new(0,192,0,0),BackgroundColor3=C.panel,BorderSizePixel=0}, root)

-- header
local head = new("Frame",{Size=UDim2.new(1,0,0,48),BackgroundTransparency=1}, main)
hline(head,C.lineS)
padAll(head,0,0,20,20)
lbl({Size=UDim2.new(1,-40,1,0),Text="Shopkeeper greets by name",TextSize=13,TextColor3=C.text}, head)
lbl({Size=UDim2.new(0,30,1,0),Position=UDim2.new(1,-30,0,0),Text="⚙",TextSize=18,TextColor3=C.muted,
	TextXAlignment=Enum.TextXAlignment.Right}, head)

-- stream
local stream = new("ScrollingFrame",{Size=UDim2.new(1,0,1,-48-96),Position=UDim2.new(0,0,0,48),
	BackgroundColor3=C.panel,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=C.line,
	CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y}, main)
padAll(stream,20,10,20,20)
new("UIListLayout",{Padding=UDim.new(0,3),SortOrder=Enum.SortOrder.LayoutOrder}, stream)

local ord=0
local function ln(text,color,mono,order)
	ord+=1
	return lbl({Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Text=text,
		TextColor3=color or C.muted,FontFace=mono and MONO or SANS,TextSize=13,TextWrapped=true,
		TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=order or ord}, stream)
end
local function bubble(text)
	ord+=1
	local b=new("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,
		BackgroundColor3=C.panel2,BorderSizePixel=0,LayoutOrder=ord}, stream)
	corner(b,13); strokeIt(b,C.lineS); padAll(b,10,10,14,14)
	new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder}, b)
	lbl({Size=UDim2.new(1,0,0,12),Text="YOU",TextSize=10,TextColor3=C.muted2,LayoutOrder=1}, b)
	lbl({Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Text=text,TextSize=13,
		TextColor3=C.text,TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top,LayoutOrder=2}, b)
	return b
end
local function divider(ts)
	ord+=1
	local d=new("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,LayoutOrder=ord}, stream)
	new("Frame",{Size=UDim2.new(0.42,0,0,1),Position=UDim2.new(0,0,0.5,0),BackgroundColor3=C.lineS,BorderSizePixel=0}, d)
	new("Frame",{Size=UDim2.new(0.42,0,0,1),Position=UDim2.new(1,0,0.5,0),AnchorPoint=Vector2.new(1,0),BackgroundColor3=C.lineS,BorderSizePixel=0}, d)
	lbl({Size=UDim2.fromScale(1,1),Text=ts,FontFace=MONO,TextSize=10,TextColor3=C.muted2,
		TextXAlignment=Enum.TextXAlignment.Center}, d)
end

-- ===================== INPUT BAR ============================================
local ibar = new("Frame",{Size=UDim2.new(1,0,0,96),Position=UDim2.new(0,0,1,-96),BackgroundColor3=C.panel,BorderSizePixel=0}, main)
hline(ibar,C.lineS,true)
padAll(ibar,14,14,18,18)
local field = new("Frame",{Size=UDim2.new(1,0,0,40),BackgroundColor3=C.panel2,BorderSizePixel=0}, ibar)
corner(field,12); local fStroke=Instance.new("UIStroke"); fStroke.Color=C.line; fStroke.Parent=field
local box = new("TextBox",{Size=UDim2.new(1,-24,1,0),Position=UDim2.new(0,12,0,0),BackgroundTransparency=1,
	TextColor3=C.text,PlaceholderColor3=C.muted2,PlaceholderText="Ask Cortex to build or fix something…",
	FontFace=SANS,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,Text=""}, field)
box.Focused:Connect(function() fStroke.Color=C.muted2 end)
box.FocusLost:Connect(function() fStroke.Color=C.line end)

local modelBtn = new("TextButton",{Size=UDim2.new(0,180,0,28),Position=UDim2.new(0,0,0,52),
	BackgroundColor3=C.panel,BorderSizePixel=0,AutoButtonColor=false,Text="",}, ibar)
corner(modelBtn,8); strokeIt(modelBtn,C.line)
local modelTxt=lbl({Size=UDim2.new(1,-16,1,0),Position=UDim2.new(0,9,0,0),Text="",TextSize=12,TextColor3=C.muted}, modelBtn)
local function refreshModel() modelTxt.Text = MODELS[modelIndex][1].."   "..MODELS[modelIndex][2].."u  ▾" end
refreshModel()
modelBtn.MouseButton1Click:Connect(function() modelIndex=(modelIndex%#MODELS)+1; refreshModel() end)

local send = new("TextButton",{Size=UDim2.new(0,32,0,28),Position=UDim2.new(1,-32,0,52),BackgroundColor3=C.accent,
	BorderSizePixel=0,AutoButtonColor=true,Text="↑",FontFace=SANS_B,TextSize=16,TextColor3=Color3.fromHex("2a1002")}, ibar)
corner(send,8)

-- hover tweens (replace CSS transitions)
local function hover(btnObj, strokeObj, txtObj)
	btnObj.MouseEnter:Connect(function()
		if strokeObj then TweenService:Create(strokeObj,TweenInfo.new(0.2),{Color=C.muted2}):Play() end
		if txtObj then TweenService:Create(txtObj,TweenInfo.new(0.2),{TextColor3=C.text}):Play() end
	end)
	btnObj.MouseLeave:Connect(function()
		if strokeObj then TweenService:Create(strokeObj,TweenInfo.new(0.2),{Color=C.line}):Play() end
		if txtObj then TweenService:Create(txtObj,TweenInfo.new(0.2),{TextColor3=C.muted}):Play() end
	end)
end

-- ===================== LOGIC ================================================
local function getKey() return plugin:GetSetting("cortex_key") end
local function setKey(k) plugin:SetSetting("cortex_key",k) end
local function selectedScript()
	for _,i in ipairs(Selection:Get()) do if i:IsA("LuaSourceContainer") then return i end end
end
local function extractCode(r) return r and (r:match("```lua%s*\n(.-)```") or r:match("```%s*\n(.-)```")) end
local lastCode
local function callCortex(system,text)
	local key=getKey(); if not key or #key==0 then return nil,"no-key" end
	local ok,res=pcall(function() return HttpService:RequestAsync({Url=BASE,Method="POST",
		Headers={["Content-Type"]="application/json",["Authorization"]="Bearer "..key},
		Body=HttpService:JSONEncode({system=system,text=text,tier=MODELS[modelIndex][3] or "osa-smart"})}) end)
	if not ok then return nil,"net" end
	if not res.Success then return nil,"HTTP "..tostring(res.StatusCode) end
	local g,d=pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not g then return nil,"json" end
	return d.text
end
local function mock(name,req)
	return ("(offline demo)\nFor `%s` you asked: \"%s\".\n```lua\n-- Cortex: %s\nprint(\"Cortex wired in\")\n```"):format(name or "selection",req,req)
end

local busy=false
local function runReq()
	if busy then return end
	local req=box.Text; if #req==0 then return end
	if req:sub(1,5)=="/key " then setKey(req:sub(6)); box.Text=""; ln("key saved",C.add,false); return end
	if req=="/new" then for _,c in ipairs(stream:GetChildren()) do if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end end ord=0; box.Text=""; return end
	if req=="/apply" then local s=selectedScript(); if not s then ln("no script selected",C.muted,true) elseif not lastCode then ln("nothing to apply",C.muted,true) else s.Source=lastCode; ln("applied to "..s.Name,C.add,true) end box.Text=""; return end

	busy=true; box.Text=""
	divider("now")
	bubble(req)
	local s=selectedScript(); local ctx=""
	if s then ln("· read "..s.ClassName.." › "..s.Name,C.muted,true); ctx="\n\nSelected script ("..s.Name.."):\n"..s.Source
	else ln("· no script selected",C.muted,true) end
	local sys="You are Cortex, a Roblox Luau coding assistant in Studio. Be concise. When you change code, return the full updated script in a ```lua block."..ctx
	local t0=os.clock()
	local reply=callCortex(sys,req) or mock(s and s.Name,req)
	local ms=os.clock()-t0
	ln(reply,C.muted,true)
	lastCode=extractCode(reply)
	if lastCode then ln("· code ready — /apply to write it in",C.accent,true) end
	ln(("%.1fs   ·   %s   ·   1 agent"):format(ms,MODELS[modelIndex][1]),C.muted2,true)
	busy=false
end
send.MouseButton1Click:Connect(runReq)
box.FocusLost:Connect(function(enter) if enter then runReq() end end)

hover(newBtn,newBtn:FindFirstChildOfClass("UIStroke"),newBtn:FindFirstChildOfClass("TextLabel"))
hover(upg,upg:FindFirstChildOfClass("UIStroke"),upg)
hover(modelBtn,modelBtn:FindFirstChildOfClass("UIStroke"),modelTxt)

-- ===================== greeting (working prototype) =========================
ln("Cortex ready.",C.text,false)
ln("1. connect:  /key YOUR_KEY",C.muted,true)
ln("2. select a script in the Explorer",C.muted,true)
ln("3. describe a change, then hit send",C.muted,true)
ln("apply the result with  /apply  ·  clear with  /new",C.muted2,true)
if getKey() then ln("· key set — ready",C.add,true) else ln("· no key yet — /key to connect",C.accent,true) end

-- fade the whole panel in (replaces CSS load animation)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	if widget.Enabled then
		root.BackgroundTransparency=1
		TweenService:Create(root,TweenInfo.new(0.35),{BackgroundTransparency=0}):Play()
	end
end)
root.BackgroundTransparency=0
]]></ProtectedString>
    </Properties>
  </Item>
</roblox>
